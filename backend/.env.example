# Template only; never commit real secrets.
APP_NAME=Legal AI Assistant
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LLM_API_KEY=
LLM_API_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=500
# Optional scanned-PDF OCR; install Tesseract OCR and add tesseract.exe to PATH first.
OCR_ENABLED=false
OCR_LANGUAGES=eng
OCR_DPI=150
MAX_OCR_PAGES=50
# DATA_DIR defaults to backend/data; keep private data outside version control.

